APP_NAME="Library Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=library_management
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Transactional password-reset email via Brevo HTTPS API (not SMTP).
BREVO_API_KEY=
BREVO_SENDER_EMAIL="hello@example.com"
BREVO_SENDER_NAME="RCJK Library"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LIBRARY_DEFAULT_LOAN_DAYS=14
LIBRARY_MAX_ACTIVE_LOANS=3
LIBRARY_DUE_SOON_DAYS=3
LIBRARY_REQUIRE_EMAIL_VERIFICATION=false
LIBRARY_REQUIRE_MEMBER_APPROVAL=false
LIBRARY_FIRST_ADMIN_NAME="Library Administrator"
LIBRARY_FIRST_ADMIN_EMAIL=admin@example.com
LIBRARY_FIRST_ADMIN_PASSWORD=change-me

# Expo push notifications. Leave disabled for local work until the Android
# app has a valid Expo/EAS project ID and a queue worker is running.
EXPO_PUSH_NOTIFICATIONS_ENABLED=false
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
